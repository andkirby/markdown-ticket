{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "frontend/src/**/*.tsx",
        "frontend/src/**/*.ts",
        "frontend/src/test-setup.ts",
        "frontend/tailwind.config.js",
        "frontend/postcss.config.js",
        "frontend/vite.config.ts"
      ],
      "project": [
        "frontend/src/**/*.ts",
        "frontend/src/**/*.tsx"
      ]
    },
    "server": {
      "entry": [
        "server.ts",
        "eslint.config.ts",
        "scripts/**/*.ts"
      ],
      "project": [
        "**/*.ts",
        "*.ts"
      ]
    },
    "cli": {
      "project": [
        "src/**/*.ts"
      ],
      "entry": [
        "src/**/*.ts",
        "tests/**/*.test.ts",
        "tests/**/*.spec.ts"
      ]
    },
    "shared": {
      "entry": [
        "index.ts",
        "tools/**/*.ts",
        "**/__tests__/**/*.test.ts",
        "**/__tests__/**/*.spec.ts",
        "**/tests/**/*.test.ts",
        "**/tests/**/*.spec.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "domain-contracts": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "mcp-server": {
      "entry": [
        "src/index.ts",
        "src/**/__tests__/**/*.test.ts",
        "src/**/__tests__/**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "cloud": {
      "project": [
        "src/**/*.ts"
      ],
      "entry": [
        "src/cloudflare/worker.ts",
        "test/**/*.test.ts"
      ]
    }
  },
  "ignore": [
    ".claude/**",
    "**/__mocks__/**",
    "**/mcp-dev-tools/**",
    "scripts/**",
    ".gitWT/**",
    "docs/**",
    "plugins/**"
  ],
  "ignoreBinaries": [
    "jq",
    "prettier",
    "rimraf",
    "rg",
    "lefthook"
  ],
  "ignoreDependencies": [
    "happy-dom",
    "swagger-jsdoc",
    "@typescript-eslint/eslint-plugin",
    "@typescript-eslint/parser",
    "markdownlint-cli2",
    "autoprefixer",
    "postcss",
    "glob"
  ],
  "ignoreIssues": {
    "server/**": [
      "exports",
      "types"
    ],
    "frontend/**": [
      "types",
      "unresolved",
      "duplicates"
    ],
    "domain-contracts/src/app-config/input.ts": [
      "duplicates"
    ],
    "server/tests/mocks/**": [
      "files"
    ],
    "mcp-server/src/tools/config/allTools.ts": [
      "exports"
    ],
    "shared/services/cloud-sync/**": [
      "files"
    ],
    "shared/services/MarkdownSectionService.ts": [
      "files"
    ],
    "shared/services/cloud-sync/recovery.ts": [
      "files"
    ],
    "shared/ticketDto.ts": [
      "files"
    ],
    "shared/utils/server-logger.ts": [
      "files"
    ],
    "shared/test-lib/utils/timeout.ts": [
      "files"
    ],
    "cloud/src/cloudflare/durable/ProjectProjectionHub.ts": [
      "exports",
      "types",
      "unlisted"
    ],
    "cloud/src/cloudflare/d1/statements.ts": [
      "exports",
      "types"
    ],
    "cloud/src/cloudflare/scheduled/maintenance.ts": [
      "exports",
      "types"
    ],
    "cloud/src/cloudflare/d1/projection.ts": [
      "exports",
      "types"
    ],
    "cloud/src/cloudflare/durable/projection-hub-helpers.ts": [
      "exports",
      "types"
    ],
    "cloud/src/cloudflare/d1/membership.ts": [
      "exports",
      "types"
    ],
    "cloud/src/cloudflare/application/reservation.ts": [
      "types"
    ],
    "cloud/src/cloudflare/rate-limit/guard.ts": [
      "types"
    ],
    "cloud/src/cloudflare/application/provisioning.ts": [
      "types"
    ],
    "cloud/src/cloudflare/d1/audit.ts": [
      "types"
    ],
    "cloud/src/cloudflare/d1/project.ts": [
      "types"
    ],
    "shared/services/ticket/DependencyGraph.ts": [
      "types"
    ],
    "shared/services/ticket/TicketIdentityService.ts": [
      "types"
    ],
    "shared/services/TicketService.ts": [
      "types"
    ]
  }
}
