{
  "version": 1,
  "ticket": {
    "key": "MDT-262"
  },
  "requirements": [
    {
      "id": "BR-1.1",
      "kind": "behavior",
      "text": "WHEN an agent manages project setup, the system shall expose project init, current, get and list through native tools; info/list aliases reuse their matching operation.",
      "sourceRef": "requirements.md#semantic-decisions",
      "routePolicy": "bdd"
    },
    {
      "id": "BR-1.2",
      "kind": "behavior",
      "text": "WHEN an agent manages tickets, the system shall expose get, list with pagination/selectors, create with optional content, attr, deps, rename and cwd-only delete through native tools.",
      "sourceRef": "requirements.md#semantic-decisions",
      "routePolicy": "bdd"
    },
    {
      "id": "BR-2.1",
      "kind": "behavior",
      "text": "WHEN an agent manages traceability, the system shall expose init, entity upsert/list/delete including dry-run, requirements lock, validate, render and task bundle as native tools.",
      "sourceRef": "requirements.md#semantic-decisions",
      "routePolicy": "bdd"
    },
    {
      "id": "BR-3.1",
      "kind": "behavior",
      "text": "WHEN an agent or maintainer needs tool guidance, the plugin shall provide schema descriptions, an on-demand usage skill and organized capability/verification documentation linked from root README.",
      "sourceRef": "requirements.md#semantic-decisions",
      "routePolicy": "bdd"
    },
    {
      "id": "C1",
      "kind": "constraint",
      "text": "The native tool surface shall exclude all cloud commands and arbitrary command escape hatches; cloud remains CLI-only.",
      "sourceRef": "requirements.md#semantic-decisions",
      "routePolicy": "tests"
    },
    {
      "id": "C2",
      "kind": "constraint",
      "text": "The adapter shall resolve the thread workspace and reject remote hosts before spawn, keep option-like inputs from changing command semantics, and follow CLI-specific project targeting.",
      "sourceRef": "requirements.md#semantic-decisions",
      "routePolicy": "tests"
    },
    {
      "id": "C3",
      "kind": "constraint",
      "text": "The subprocess adapter shall preserve cancellation, timeouts, 256 KiB combined output limits, explicit binary/errors, command-specific text/JSON output and explicit create-content stdin.",
      "sourceRef": "requirements.md#semantic-decisions",
      "routePolicy": "tests"
    },
    {
      "id": "C4",
      "kind": "constraint",
      "text": "Shared tool definitions shall remain canonical with install-safe BB copies checked for drift and DSH offline adapter parity.",
      "sourceRef": "requirements.md#semantic-decisions",
      "routePolicy": "tests"
    },
    {
      "id": "C5",
      "kind": "constraint",
      "text": "Coverage documentation shall distinguish implementation, automated checks, fresh BB live checks and separately pending DSH live checks.",
      "sourceRef": "requirements.md#semantic-decisions",
      "routePolicy": "tests"
    }
  ],
  "scenarios": [
    {
      "id": "project_lifecycle",
      "title": "Manage an isolated project",
      "covers": [
        "BR-1.1"
      ],
      "given": "an unconfigured temporary directory and isolated registry",
      "when": "the agent initializes a project and invokes current, get and list",
      "then": "the new project code and paths are discoverable",
      "sourceRef": "bdd.md#journeys"
    },
    {
      "id": "ticket_lifecycle",
      "title": "Complete ticket lifecycle",
      "covers": [
        "BR-1.2"
      ],
      "given": "a configured temporary project",
      "when": "the agent creates content, gets, filters/pages, changes attributes, checks dependencies, renames and deletes a ticket",
      "then": "each operation reflects persisted state and deletion removes the fixture ticket",
      "sourceRef": "bdd.md#journeys"
    },
    {
      "id": "trace_lifecycle",
      "title": "Complete trace lifecycle",
      "covers": [
        "BR-2.1"
      ],
      "given": "a temporary project ticket",
      "when": "the agent initializes trace, upserts/lists entities, dry-runs/deletes an entry, locks, validates, renders and bundles",
      "then": "trace state and derived outputs match the requested operations",
      "sourceRef": "bdd.md#journeys"
    },
    {
      "id": "discover_tool_guidance",
      "title": "Discover usage and coverage",
      "covers": [
        "BR-3.1"
      ],
      "given": "the native plugin is installed",
      "when": "an agent reads tool schemas and loads the mdt-tools skill and a maintainer opens the plugin entry point",
      "then": "supported commands, concrete examples and CLI-only cloud status are discoverable",
      "sourceRef": "bdd.md#journeys"
    }
  ],
