{
  "version": 1,
  "ticket": {
    "key": "MDT-261"
  },
  "requirements": [
    {
      "id": "BR-1.1",
      "kind": "behavior",
      "text": "WHEN ticket creation generates a body from absent, empty or whitespace-only input, the system shall return success with one actionable template diagnostic identifying the created ticket and requiring replacement of unfinished instructions before commit.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "bdd",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "BR-1.2",
      "kind": "behavior",
      "text": "WHEN ticket creation receives supplied content, the system shall report recognized unfinished scaffolding without claiming template generation for genuine supplied content.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "bdd",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "BR-1.3",
      "kind": "behavior",
      "text": "WHEN creation succeeds through CLI human, JSON or YAML output, MCP, HTTP, BB or DSH, the system shall expose equivalent shared diagnostics without losing successful creation semantics or duplicating a finding.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "bdd",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "BR-2.1",
      "kind": "behavior",
      "text": "WHEN a staged primary ticket contains an active explicit placeholder marker, known unfinished template instruction or only structural boilerplate, the system shall reject validation with ticket key, relative path, line or section, offending content and a correction.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "bdd",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "BR-2.3",
      "kind": "behavior",
      "text": "WHEN staged and working-tree contents differ, the system shall decide validation from the complete staged document and staged project configuration.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "bdd",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "BR-2.4",
      "kind": "behavior",
      "text": "WHEN a commit is validated, the system shall inspect only added, modified or renamed primary Markdown tickets including epics under configured project paths and codes, skipping deletions and unrelated historical or specification documents.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "bdd",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "BR-2.5",
      "kind": "behavior",
      "text": "IF a detected MDT project cannot execute its required validator or snapshot inspection fails, THEN the system shall reject the commit with an actionable failure instead of reporting a clean validation.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "bdd",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "C1",
      "kind": "constraint",
      "text": "The system shall define canonical diagnostic schemas in domain-contracts and detection plus message construction in shared, leaving adapters responsible only for transport presentation.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "tests",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "C2",
      "kind": "constraint",
      "text": "The system shall keep diagnostics outside persisted ticket frontmatter and domain entities while preserving existing creation-result consumers through an explicit compatibility API.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "tests",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "C3",
      "kind": "constraint",
      "text": "The system shall use one owned template instruction source for generation and recognition, including file, fallback and legacy compatibility phrases and deterministic markers on future generated instructions.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "tests",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "C4",
      "kind": "constraint",
      "text": "The system shall perform staged validation locally without network requests, a running MDT server, content mutation or index mutation.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "tests",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "C5",
      "kind": "constraint",
      "text": "The system shall wire the validator through tracked local Lefthook configuration and record successful local verification before changing the separate shared-hooks repository.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "tests",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "C6",
      "kind": "constraint",
      "text": "The system shall pass repository paths, blob identifiers and supplied content as data without shell evaluation or unsafe argument expansion.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "tests",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "Edge-1",
      "kind": "edge_case",
      "text": "WHEN tickets are renamed or contain spaces in paths, the system shall read the correct staged blob using unambiguous Git path handling.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "tests",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "Edge-2",
      "kind": "edge_case",
      "text": "WHILE a ticket is not completed, the system shall allow the legacy deferred implementation instruction only in Implementation Notes and shall leave the existing Implemented-task policy independent.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#2-desired-outcome",
      "routePolicy": "tests",
      "tags": [
        "timing:in-ticket"
      ]
    },
    {
      "id": "BR-2.2",
      "kind": "behavior",
      "text": "WHEN a staged ticket has genuine concise content, the system shall permit ordinary planning annotations, technical brackets, links, intentional quoted or code examples, unchecked intake criteria and allowed legacy Implementation Notes before completion.",
      "sourceRef": "docs/CRs/MDT-261-unfinished-ticket-templates.md#placeholder-policy",
      "routePolicy": "bdd",
      "tags": [
        "timing:in-ticket"
      ]
    }
  ],
  "scenarios": [
    {
      "id": "generated_body_notice",
      "title": "Generated body is visibly unfinished",
      "covers": [
        "BR-1.1",
        "BR-1.3"
      ],
      "given": "I have an MDT project and omit the body or supply only whitespace",
      "when": "I create a ticket using a supported creation surface",
      "then": "Creation succeeds and returns one shared warning with the created ticket location and instruction to complete it before committing",
      "sourceRef": "requirements:MDT-261"
    },
    {
      "id": "authored_body_clean",
      "title": "Authored body stays clean",
      "covers": [
        "BR-1.2"
      ],
      "given": "I supply a concise real problem and desired outcome",
      "when": "I create a ticket",
      "then": "Creation succeeds without a template-generated warning",
      "sourceRef": "requirements:MDT-261"
    },
    {
      "id": "supplied_instruction_notice",
      "title": "Supplied template instructions are detected",
      "covers": [
        "BR-1.2",
        "BR-1.3"
      ],
      "given": "I supply content that still contains an unfinished template instruction",
      "when": "I create a ticket using a supported creation surface",
      "then": "Creation succeeds and exposes the same shared content finding through the surface",
      "sourceRef": "requirements:MDT-261"
    },
    {
      "id": "unfinished_staged_body",
      "title": "Unfinished staged ticket is rejected",
      "covers": [
        "BR-2.1"
      ],
      "given": "My staged ticket contains a known architecture prompt, explicit unfinished marker, partial prompt or empty scaffold",
      "when": "I validate the proposed commit",
      "then": "Validation rejects it with ticket, path, location, offending instruction and required correction",
      "sourceRef": "requirements:MDT-261"
    },
    {
      "id": "genuine_staged_body",
      "title": "Genuine concise ticket and intentional examples are accepted",
      "covers": [
        "BR-2.2"
      ],
      "given": "My staged ticket has real content and may quote instructions or contain planning annotations and unchecked intake criteria",
      "when": "I validate the proposed commit",
      "then": "Validation accepts the ticket without demanding later-stage implementation content",
      "sourceRef": "requirements:MDT-261"
    },
    {
      "id": "staged_version_wins",
      "title": "The staged version determines the verdict",
      "covers": [
        "BR-2.3"
      ],
      "given": "The staged ticket or project configuration differs from my working copy",
      "when": "I validate the proposed commit",
      "then": "Only the complete staged ticket and staged configuration determine acceptance or rejection",
      "sourceRef": "requirements:MDT-261"
    },
    {
      "id": "changed_primary_scope",
      "title": "Only changed primary tickets are inspected",
      "covers": [
        "BR-2.4"
      ],
      "given": "I have unchanged historical scaffolds and unrelated specification documents alongside a changed or renamed primary ticket",
      "when": "I validate the proposed commit",
      "then": "Only the changed primary ticket including an epic is inspected and deletions are skipped",
      "sourceRef": "requirements:MDT-261"
    },
    {
      "id": "validator_failure_visible",
      "title": "Unavailable or failed validator blocks explicitly",
      "covers": [
        "BR-2.5"
      ],
      "given": "My detected MDT project has an unavailable validator or unreadable staged snapshot",
      "when": "I attempt the guarded commit",
      "then": "The commit is rejected with an actionable validation failure",
      "sourceRef": "requirements:MDT-261"
    }
  ],
