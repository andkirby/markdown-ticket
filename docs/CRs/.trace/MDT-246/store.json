{
  "version": 1,
  "ticket": {
    "key": "MDT-246"
  },
  "requirements": [
    {
      "id": "BR-1.1",
      "kind": "behavior",
      "text": "Epic detail header shows an \"Epics →\" action (Rows3 leading glyph, trailing arrow-right) beside Trace Graph when ticket.level is epic; tooltip and accessible name carry the full sentence \"Show MDT-### on Epics board\"",
      "sourceRef": "CR:MDT-246",
      "routePolicy": "bdd"
    },
    {
      "id": "BR-1.2",
      "kind": "behavior",
      "text": "In detail surfaces (viewer header, ticket attributes) a linkable phase value renders as a split chip: identity zone (passive Zap + key link) plus a trailing labeled action button of at least 24x24 jumping to the epics board; board cards keep the compact badge and the Zap is never a click target",
      "sourceRef": "CR:MDT-246",
      "routePolicy": "bdd"
    },
    {
      "id": "BR-1.3",
      "kind": "behavior",
      "text": "Both entry points navigate to /prj/:code/epics?epic=:key in one navigation; the ticket modal closes with it and no orphaned modal state remains",
      "sourceRef": "CR:MDT-246",
      "routePolicy": "bdd"
    },
    {
      "id": "BR-1.4",
      "kind": "behavior",
      "text": "SwimlaneBoard with focusEpicKey: the lane is expanded (and persisted), scrolled into view, and transiently highlighted in its epic color with auto-clear after about 2 seconds",
      "sourceRef": "CR:MDT-246",
      "routePolicy": "bdd"
    },
    {
      "id": "BR-1.5",
      "kind": "behavior",
      "text": "The focused lane renders even when Hide empty or Show closed would exclude it; an active search that would exclude it is cleared on arrival; filter toggles are untouched",
      "sourceRef": "CR:MDT-246",
      "routePolicy": "bdd"
    },
    {
      "id": "BR-1.6",
      "kind": "behavior",
      "text": "An unknown or missing ?epic= token is ignored; the board renders normally with no error state",
      "sourceRef": "CR:MDT-246",
      "routePolicy": "bdd"
    },
    {
      "id": "BR-1.7",
      "kind": "behavior",
      "text": "Ticket links opened from inside a ticket modal carry the current ?view= context so closing the opened ticket returns to the originating view",
      "sourceRef": "CR:MDT-246",
      "routePolicy": "bdd"
    },
    {
      "id": "C-1",
      "kind": "constraint",
      "text": "Split-chip action zone hit target is at least 24x24 (MDT-236 a11y floor) and the visible label is a substring of the accessible name (Label-in-Name)",
      "sourceRef": "CR:MDT-246",
      "routePolicy": "tests"
    },
    {
      "id": "C-2",
      "kind": "constraint",
      "text": "The ?epic= token is never rewritten onto non-/epics routes; in-app navigation drops it naturally",
      "sourceRef": "CR:MDT-246",
      "routePolicy": "tests"
    },
    {
      "id": "C-3",
      "kind": "constraint",
      "text": "Board cards (scan surfaces) never render the split-chip action zone",
      "sourceRef": "CR:MDT-246",
      "routePolicy": "tests"
    },
    {
      "id": "Edge-1",
      "kind": "edge_case",
      "text": "Local storage unavailable or corrupted: focus expansion still applies in-memory and arrival never blocks on persistence failure",
      "sourceRef": "CR:MDT-246",
      "routePolicy": "tests"
    }
  ],
  "scenarios": [
    {
      "id": "epic_detail_header_cta",
      "title": "Epic detail header shows the Epics board CTA",
      "covers": [
        "BR-1.1"
      ],
      "given": "Given an open ticket with level epic",
      "when": "When the detail header renders",
      "then": "Then an \"Epics →\" action with Rows3 and trailing arrow-right renders beside Trace Graph with the full-sentence tooltip and accessible name",
      "sourceRef": "CR:MDT-246"
    },
    {
      "id": "split_chip_jump_to_epics_board",
      "title": "Epic badge split chip jumps to the focused board",
      "covers": [
        "BR-1.2",
        "BR-1.3"
      ],
      "given": "Given an open non-epic ticket whose phaseEpic is a ticket key in a detail surface",
      "when": "When the split-chip action zone is activated",
      "then": "Then the app navigates in one step to /prj/:code/epics?epic=KEY and the ticket modal is closed",
      "sourceRef": "CR:MDT-246"
    },
    {
      "id": "focused_arrival_expand_scroll_highlight",
      "title": "Focused arrival expands scrolls and highlights the lane",
      "covers": [
        "BR-1.4"
      ],
      "given": "Given the Epics board route with ?epic=KEY for a known epic",
      "when": "When the board mounts",
      "then": "Then the lane is expanded and persisted scrolled into view and transiently highlighted in its epic color with auto-clear",
      "sourceRef": "CR:MDT-246"
    },
    {
      "id": "focused_lane_visibility_override",
      "title": "Focused lane overrides visibility filters",
      "covers": [
        "BR-1.5"
      ],
      "given": "Given Hide empty or Show closed would exclude the focused lane and an active search does not match it",
      "when": "When arrival focus applies",
      "then": "Then the focused lane still renders and the search is cleared while filter toggles stay untouched",
      "sourceRef": "CR:MDT-246"
    },
    {
      "id": "unknown_epic_token_ignored",
      "title": "Unknown epic token is ignored",
      "covers": [
        "BR-1.6"
      ],
      "given": "Given the Epics board route with ?epic=UNKNOWN or no token",
      "when": "When the board mounts",
      "then": "Then the board renders normally with no error state",
      "sourceRef": "CR:MDT-246"
    },
    {
      "id": "view_context_carried_from_ticket_modal",
      "title": "Ticket links inside a ticket modal carry the view context",
      "covers": [
        "BR-1.7"
      ],
      "given": "Given a ticket modal opened from the Epics view",
      "when": "When a ticket link inside the modal opens another ticket",
      "then": "Then the new ticket URL carries ?view=epics and closing it returns to the Epics view",
      "sourceRef": "CR:MDT-246"
    }
  ],
