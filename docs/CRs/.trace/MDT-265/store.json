    "key": "MDT-265"
  },
  "requirements": [
    {
      "id": "C1",
      "kind": "constraint",
      "text": "Frontend stored-key parsers must derive project and 3–5 digit bounds from domain-contracts, including alphanumeric codes, without matching partial invalid keys.",
      "sourceRef": "../MDT-265-mdt-265-derive-frontend-pathlink-ticket-key-parser.md#acceptance",
      "routePolicy": "tests"
    },
    {
      "id": "C2",
      "kind": "constraint",
      "text": "Preserve case sensitivity, capture layouts, anchors, document resolution, and historical letter-prefixed link support where it already exists.",
      "sourceRef": "../MDT-265-mdt-265-derive-frontend-pathlink-ticket-key-parser.md#acceptance",
      "routePolicy": "tests"
    },
    {
      "id": "C3",
      "kind": "constraint",
      "text": "No independently hardcoded ticket-key regex may remain in frontend runtime source; test markdown, links, normalization, validation and SSE routing.",
      "sourceRef": "../MDT-265-mdt-265-derive-frontend-pathlink-ticket-key-parser.md#acceptance",
      "routePolicy": "tests"
    },
    {
      "id": "C4",
      "kind": "constraint",
      "text": "Canonical key syntax is exported as a pattern body by domain-contracts; WorktreeService alone extracts branch identity, watcher lifecycle uses that identity and exact gitdir root, and shared title fallback derives from the same contract.",
      "sourceRef": "architecture.md#follow-up-investigation",
      "routePolicy": "tests"
    },
    {
      "id": "C5",
      "kind": "constraint",
      "text": "Frontend verification exercises the real markdown hook with supported DOMPurify/JSDOM sanitation and preserves meaningful rendering and XSS assertions; preference expectations match one-time migration and async route tests use React act.",
      "sourceRef": "architecture.md#follow-up-investigation",
      "routePolicy": "tests"
    },
    {
      "id": "C6",
      "kind": "constraint",
      "text": "Relative markdown and HTML document references share one grammar including anchors without broadening URL schemes or absolute-path handling.",
      "sourceRef": "architecture.md#follow-up-investigation",
      "routePolicy": "tests"
    },
    {
      "id": "C7",
      "kind": "constraint",
      "text": "Worktree discovery and shutdown must respect project and HEAD lifetimes: delayed results cannot register after stop/unlink, and detached old cleanup cannot remove replacement generations or another project.",
      "sourceRef": "architect-review.md",
      "routePolicy": "tests"
    },
    {
      "id": "C8",
      "kind": "constraint",
      "text": "Protected Markdown/HTML filename references must resolve through the existing document resolver in documents context without requiring a ticket key, preserving whole paths and disabled document-link settings.",
      "sourceRef": "architect-review.md",
      "routePolicy": "tests"
    }
  ],
