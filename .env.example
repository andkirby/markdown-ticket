# Environment Variables for Markdown Ticket
# Copy to .env and customize for your environment

# Development (native) configuration
# VITE_BACKEND_URL=http://localhost:3001

# Docker configuration (used by docker-compose.dev.yml)
# VITE_BACKEND_URL=http://backend:3001

# Frontend logging
VITE_FRONTEND_LOGGING_AUTOSTART=false

# Vite HMR settings (optional)
VITE_HMR_HOST=localhost
VITE_HMR_PORT=5173

# MCP Server Configuration
# MCP_HTTP_ENABLED=false                     # Enable HTTP transport for MCP server (default: false)
# MCP_HTTP_PORT=3002                         # HTTP port for MCP server (default: 3002)
# MCP_BIND_ADDRESS=127.0.0.1                 # Bind address for MCP server (default: 127.0.0.1)

# MCP Server Security (Phase 2 - Optional)
# MCP_SECURITY_RATE_LIMITING=false           # Enable rate limiting (default: false)
# MCP_RATE_LIMIT_MAX=100                     # Max requests per window (default: 100)
# MCP_RATE_LIMIT_WINDOW_MS=60000             # Rate limit window in ms (default: 1 min)

# MCP Server Beta Features
# MCP_SANITIZATION_ENABLED=false             # Enable output sanitization (BETA - default: false)
#                                            # WARNING: Sanitization is in beta testing. May affect performance.
#                                            # To enable: MCP_SANITIZATION_ENABLED=true

# Public Origin (optional)
# PUBLIC_ORIGIN=https://your-domain.example
#                                            # Canonical browser/API and generated-link origin
#                                            - Must be a full http(s) origin
#                                            - Backend allows this origin for browser API calls
#                                            - Vite derives the allowed host from this origin
#                                            - Set in .env.local to keep private domains out of git

# Backend Bind & Local No-Auth Bypass (MDT-157 UAT 2026-08-06)
# API_BIND_ADDRESS=127.0.0.1                  # Backend listen interface (default: 127.0.0.1 loopback)
#                                            # Loopback keeps :3001 unreachable from LAN/internet.
#                                            # Docker sets 0.0.0.0 so the frontend/nginx container reaches it.
# API_LOCAL_HOSTS=localhost,127.0.0.1,::1     # CSV of Host hostnames treated as loopback for the no-auth
#                                            # carve-out (default: localhost,127.0.0.1,::1).
# API_LOCAL_HOST_BYPASS=                      # Master switch for loopback-host no-auth (default: on when
#                                            # NODE_ENV is unset/development/local — the `bunx tsx server.ts`
#                                            # path; off in production and test). When on, a loopback Host
#                                            # gets owner access with no token; when off, every host must
#                                            # authenticate. Read-only sessions always take precedence
#                                            # (never escalated by the bypass).
# VITE_SERVER_HOST=127.0.0.1                  # Vite dev/preview listen interface (default: 127.0.0.1).
#                                            # Set 0.0.0.0 for LAN/tunnel reach, accepting that loopback
#                                            # Host is then forgeable from that network.

