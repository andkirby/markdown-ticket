{
  // Cloud Sync Coordination Worker — deployment source of truth.
  // Permanent boundary: docs/CRs/MDT-200/cloud-package-boundary.md
  // Operations: docs/architecture/cloud-sync/operations.md
  // Production-only V1: this file contains the non-secret deployed resource
  // identifiers. Credentials remain outside the repository.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdt-cloud-sync-production",
  "main": "src/cloudflare/worker.ts",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "mdt-sync.constantapp.org",
      "custom_domain": true
    },
    {
      "pattern": "mdt-sync-admin.constantapp.org",
      "custom_domain": true
    }
  ],
  // D1 binding — one production database. Binding name is fixed: `DB`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mdt-cloud-sync-production",
      "database_id": "02996cfe-a593-4650-8983-2caf53a02d55",
      "migrations_dir": "migrations"
    }
  ],
  // Rate-limit bindings — abuse/ runaway-client guards, NOT allocation correctness.
  // See operations.md "Rate Limits". Two classes: read (projection polling)
  // and mutation (writes). Operator-mutation limiting is enforced in-app on the
  // same mutation binding.
  //
  // Wrangler key is `ratelimits` and each item's `name` is the in-Worker
  // binding identifier (there is no separate `binding` field for rate limits).
  "ratelimits": [
    {
      "name": "RATE_LIMIT_READ",
      "namespace_id": "2026072401",
      "simple": {
        "limit": 600,
        "period": 60
      }
    },
    {
      "name": "RATE_LIMIT_MUTATE",
      "namespace_id": "2026072402",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  // Scheduled maintenance — UTC, every 15 minutes.
  // Expires stale `reserved` reservations and enforces audit retention in
  // bounded batches (operations.md "Scheduled Maintenance").
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  // Non-secret environment variables. Audience tags must agree with the
  // Cloudflare Access applications (identity-and-access.md). No tokens, secrets,
  // or service credentials ever live here — use `wrangler secret put` or the
  // production secret channel.
  "vars": {
    "TEAM_DOMAIN": "kirbyapp.cloudflareaccess.com",
    "COORDINATION_AUD": "99333d6ac35035baccaefc4dda0c9b73f4b93ef4f992c402dce934b4ef42b9b2",
    "OPERATOR_AUD": "0f68fcbd27f935df8d4a8983b519b8cae02831d24fe88d09bf99ca30ea4f3efc"
  },
  // Version metadata binding for diagnostic responses and logs.
  "version_metadata": {
    "binding": "VERSION_METADATA"
  },
  // Observability — Workers Logs.
  "observability": {
    "enabled": true
  }
}
